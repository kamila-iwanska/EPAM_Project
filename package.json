{
  "name": "fundamentals-project-ts-template",
  "version": "1.0.0",
  "description": "Capstone Project TS Template",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "echo \"Dummy build script required for Autocode Compile\"",
    "ts-compile": "npx tsc",
    "compile": "sass src/scss:dist",
    "dev:build": "npm run ts-compile && npm run compile && cp -r src/html/* dist && cp -r src/image dist && cp -r src/assets dist && serve dist",
    "dev": "nodemon --watch src --ext scss,ts,html --exec \"npm run dev:build\"",
    "lint":"npx stylelint \"**/*.scss\" && npx eslint ." 
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "homepage": "https://capstone-project.k-m-iwanska.workers.dev",
  "keywords": [],
  "author": "Kamila Iwańska",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  },
  "dependencies": {
    "globals": "^17.5.0",
    "nodemon": "^3.1.14",
    "sass": "^1.99.0",
    "serve": "^14.2.6"
  }
}
